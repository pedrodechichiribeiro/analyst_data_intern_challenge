# 1. Copie este arquivo:  cp .env.example .env
#    (copie, não renomeie — renomear apaga o template do repositório)
# 2. Cole sua chave do Google AI Studio abaixo
# 3. O .env está no .gitignore. Nunca versione a chave.

GOOGLE_API_KEY=cole_sua_chave_aqui


# ============================================================
# Abaixo: só para quem for rodar via Docker. Ignore se usar venv.
# ============================================================

# UID/GID do seu usuário, para o container não rodar como root.
# Descubra com:  id -u   e   id -g
UID=1000
GID=1000

# Encadeia os arquivos de compose do seu SO. Com isso basta `docker compose up`,
# sem repetir -f a cada comando. Descomente a linha do seu caso:
COMPOSE_FILE=docker-compose.yml:docker-compose.linux.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.wslg.yml
# COMPOSE_FILE=docker-compose.yml
